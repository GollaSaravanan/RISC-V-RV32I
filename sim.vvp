v0000025CA2A39EF0_0 .var "pc", 31 0;
v0000025CA2A3DF00_0 .net "pc_next", 31 0, L_0000025CA2A37DF0;  alias, 1 drivers
v0000025CA2A3DFA0_0 .net "rst", 0 0, v0000025CA2A37E90_0;  1 drivers
E_0000025CA2A3EF70 .event posedge, v0000025CA2A261A0_0;
    .scope S_0000025CA2A3DD70;
T_0 ;
    %wait E_0000025CA2A3EF70;
    %load/vec4 v0000025CA2A3DFA0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 32;
    %assign/vec4 v0000025CA2A39EF0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0000025CA2A3DF00_0;
    %assign/vec4 v0000025CA2A39EF0_0, 0;
T_0.1 ;
