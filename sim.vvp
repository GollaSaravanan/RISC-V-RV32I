    %vpi_call 2 28 "$dumpvars", 32'sb00000000000000000000000000000000, S_0000025CA2A26AE0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000025CA2A3E0E0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0000025CA2A37E90_0, 0, 1;
    %delay 15000, 0;
