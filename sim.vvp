 .timescale -9 -12;
L_0000025CA2CE0088 .functor BUFT 1, C4<00000000000000000000000000000100>, C4<0>, C4<0>, C4<0>;
v0000025CA2A3E040_0 .net/2u *"_ivl_0", 31 0, L_0000025CA2CE0088;  1 drivers
