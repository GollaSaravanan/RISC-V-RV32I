    %store/vec4 v0000025CA2A37E90_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000025CA2A37E90_0, 0, 1;
    %delay 20000, 0;
    %vpi_call 2 38 "$finish" {0 0 0};
